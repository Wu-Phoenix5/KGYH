    <script>
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
                navbar.classList.add('py-2', 'shadow-lg');
                navbar.classList.remove('py-3', 'shadow-md');
            } else {
                navbar.classList.add('py-3', 'shadow-md');
                navbar.classList.remove('py-2', 'shadow-lg');
            }
        });

        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        let menuOpen = false;

        menuBtn.addEventListener('click', () => {
            if (menuOpen) {
                mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
                mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
                menuBtn.innerHTML = '<i class="fa fa-bars text-xl"></i>';
            } else {
                mobileMenu.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
                mobileMenu.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
                menuBtn.innerHTML = '<i class="fa fa-times text-xl"></i>';
            }
            menuOpen = !menuOpen;
        });

        const carouselSlides = document.getElementById('carouselSlides');
        const prevBtn = document.getElementById('prevSlide');
        const nextBtn = document.getElementById('nextSlide');
        const indicators = document.querySelectorAll('.carousel-indicator');
        let currentSlide = 0;
        const totalSlides = 5; // 修改为5张轮播图

        function updateSlide() {
            carouselSlides.style.transform = `translateX(-${currentSlide * 100}%)`;
            
            indicators.forEach((indicator, index) => {
                if (index === currentSlide) {
                    indicator.classList.add('bg-gold');
                    indicator.classList.remove('bg-gold/50');
                } else {
                    indicator.classList.add('bg-gold/50');
                    indicator.classList.remove('bg-gold');
                }
            });
        }

        prevBtn.addEventListener('click', () => {
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateSlide();
        });

        nextBtn.addEventListener('click', () => {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateSlide();
        });

        indicators.forEach(indicator => {
            indicator.addEventListener('click', () => {
                currentSlide = parseInt(indicator.dataset.index);
                updateSlide();
            });
        });

        let carouselInterval = setInterval(() => {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateSlide();
        }, 5000);

        document.getElementById('newsCarousel').addEventListener('mouseenter', () => {
            clearInterval(carouselInterval);
        });

        document.getElementById('newsCarousel').addEventListener('mouseleave', () => {
            carouselInterval = setInterval(() => {
                currentSlide = (currentSlide + 1) % totalSlides;
                updateSlide();
            }, 5000);
        });

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                
                if (menuOpen) {
                    mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
                    mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
                    menuBtn.innerHTML = '<i class="fa fa-bars text-xl"></i>';
                    menuOpen = false;
                }
                
                const targetId = this.getAttribute('href');
                if (targetId === '#') return;
                
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });

        const backToTopBtn = document.getElementById('backToTop');
        
        window.addEventListener('scroll', () => {
            if (window.scrollY > 500) {
                backToTopBtn.classList.remove('opacity-0', 'invisible');
                backToTopBtn.classList.add('opacity-100', 'visible');
            } else {
                backToTopBtn.classList.add('opacity-0', 'invisible');
                backToTopBtn.classList.remove('opacity-100', 'visible');
            }
        });
        
        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        document.addEventListener('DOMContentLoaded', function() {
            const videoCovers = document.querySelectorAll('.video-cover');
            const videoPlayerModal = document.querySelector('.video-player-modal');
            const closePlayerBtn = document.getElementById('closePlayerBtn');
            const mainVideoPlayer = document.getElementById('mainVideoPlayer');
            const playerVideoTitle = document.getElementById('playerVideoTitle');
            const playerVideoDesc = document.getElementById('playerVideoDesc');
            const videoProgress = document.getElementById('videoProgress');
            const currentTimeDisplay = document.getElementById('currentTime');
            const totalTimeDisplay = document.getElementById('totalTime');
            const playerPlayPause = document.getElementById('playerPlayPause');
            const playerError = document.getElementById('playerError');

            mainVideoPlayer.addEventListener('error', function() {
                mainVideoPlayer.style.display = 'none';
                playerError.style.display = 'block';
            });

            videoCovers.forEach((cover, index) => {
                cover.addEventListener('click', function() {
                    mainVideoPlayer.style.display = 'block';
                    playerError.style.display = 'none';
                    
                    const videoUrl = this.getAttribute('data-video-url');
                    // 修复：兼容左侧视频卡片，正确获取标题和描述
                    const card = this.closest('.video-cover').parentElement;
                    const videoTitle = card.querySelector('.video-title-static')?.textContent || "主题视频";
                    const videoDesc = card.querySelector('p')?.textContent || "海南全岛封关运作专题视频";
                    
                    mainVideoPlayer.src = videoUrl;
                    playerVideoTitle.textContent = videoTitle;
                    playerVideoDesc.textContent = videoDesc;
                    
                    videoPlayerModal.classList.add('active');
                    document.body.style.overflow = 'hidden';
                    
                    mainVideoPlayer.load();
                    mainVideoPlayer.play().catch(err => {
                        console.log("视频自动播放被阻止:", err);
                    });
                });
            });

            closePlayerBtn.addEventListener('click', function() {
                videoPlayerModal.classList.remove('active');
                mainVideoPlayer.pause();
                document.body.style.overflow = 'auto';
            });

            mainVideoPlayer.addEventListener('timeupdate', function() {
                const progress = (this.currentTime / this.duration) * 100;
                videoProgress.style.width = progress + '%';
                
                const currentMinutes = Math.floor(this.currentTime / 60);
                const currentSeconds = Math.floor(this.currentTime % 60);
                currentTimeDisplay.textContent = `${currentMinutes.toString().padStart(2, '0')}:${currentSeconds.toString().padStart(2, '0')}`;
            });

            mainVideoPlayer.addEventListener('loadedmetadata', function() {
                const totalMinutes = Math.floor(this.duration / 60);
                const totalSeconds = Math.floor(this.duration % 60);
                totalTimeDisplay.textContent = `${totalMinutes.toString().padStart(2, '0')}:${totalSeconds.toString().padStart(2, '0')}`;
            });

            playerPlayPause.addEventListener('click', function() {
                if (mainVideoPlayer.paused) {
                    mainVideoPlayer.play();
                    this.innerHTML = '<i class="fa fa-pause text-xl"></i>';
                } else {
                    mainVideoPlayer.pause();
                    this.innerHTML = '<i class="fa fa-play text-xl"></i>';
                }
            });
        });
        
        // 滚动新闻悬停暂停
        const newsList = document.getElementById('newsList');
        const newsScroll = document.getElementById('newsScroll');
        newsList.addEventListener('mouseenter', () => {
            newsScroll.style.animationPlayState = 'paused';
        });
        newsList.addEventListener('mouseleave', () => {
            newsScroll.style.animationPlayState = 'running';
        });
    </script>
</body>
</html>
