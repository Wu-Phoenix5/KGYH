    <script>
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
                navbar.classList.add('py-2', 'shadow-lg');
                navbar.classList.remove('py-3', 'shadow-md');
            } else {
                navbar.classList.add('py-3', 'shadow-md');
                navbar.classList.remove('py-2', 'shadow-lg');
            }
        });

        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        let menuOpen = false;

        menuBtn.addEventListener('click', () => {
            if (menuOpen) {
                mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
                mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
                menuBtn.innerHTML = '<i class="fa fa-bars text-xl"></i>';
            } else {
                mobileMenu.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
                mobileMenu.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
                menuBtn.innerHTML = '<i class="fa fa-times text-xl"></i>';
            }
            menuOpen = !menuOpen;
        });

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                if (menuOpen) {
                    mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
                    mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
                    menuBtn.innerHTML = '<i class="fa fa-bars text-xl"></i>';
                    menuOpen = false;
                }
                const targetId = this.getAttribute('href');
                if (targetId === '#') return;
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });

        const backToTopBtn = document.getElementById('backToTop');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 500) {
                backToTopBtn.classList.remove('opacity-0', 'invisible');
                backToTopBtn.classList.add('opacity-100', 'visible');
            } else {
                backToTopBtn.classList.add('opacity-0', 'invisible');
                backToTopBtn.classList.remove('opacity-100', 'visible');
            }
        });
        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        document.addEventListener('DOMContentLoaded', function() {
            const videoPlayerModal = document.querySelector('.video-player-modal');
            const closePlayerBtn = document.getElementById('closePlayerBtn');
            const mainVideoPlayer = document.getElementById('mainVideoPlayer');
            const playerPlayPause = document.getElementById('playerPlayPause');
            const videoProgress = document.getElementById('videoProgress');
            const currentTimeDisplay = document.getElementById('currentTime');
            const totalTimeDisplay = document.getElementById('totalTime');

            closePlayerBtn.addEventListener('click', function() {
                videoPlayerModal.classList.remove('active');
                mainVideoPlayer.pause();
                mainVideoPlayer.src = '';
                document.body.style.overflow = '';
            });

            playerPlayPause.addEventListener('click', function() {
                if (mainVideoPlayer.paused) {
                    mainVideoPlayer.play();
                    this.innerHTML = '<i class="fa fa-pause text-xl"></i>';
                } else {
                    mainVideoPlayer.pause();
                    this.innerHTML = '<i class="fa fa-play text-xl"></i>';
                }
            });

            mainVideoPlayer.addEventListener('timeupdate', function() {
                if (!isNaN(this.duration)) {
                    const progressPercent = (this.currentTime / this.duration) * 100;
                    videoProgress.style.width = `${progressPercent}%`;
                    currentTimeDisplay.textContent = formatTime(this.currentTime);
                    totalTimeDisplay.textContent = formatTime(this.duration);
                }
            });

            document.querySelector('.video-progress-bar').addEventListener('click', function(e) {
                const barRect = this.getBoundingClientRect();
                const clickPosition = (e.clientX - barRect.left) / barRect.width;
                if (!isNaN(mainVideoPlayer.duration)) {
                    const newTime = clickPosition * mainVideoPlayer.duration;
                    mainVideoPlayer.currentTime = newTime;
                }
            });

            function formatTime(seconds) {
                if (isNaN(seconds)) return '00:00';
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const secs = Math.floor(seconds % 60);
                if (hours > 0) {
                    return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                } else {
                    return `${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                }
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && videoPlayerModal.classList.contains('active')) {
                    closePlayerBtn.click();
                }
            });

            const audioPlayer = document.getElementById('audioPlayer');
            const audioCover = document.getElementById('audioCover');
            const audioPlayBtn = document.getElementById('audioPlayBtn');
            const audioPlayIcon = document.getElementById('audioPlayIcon');
            let isAudioPlaying = false;

            function toggleAudioPlay() {
                if (isAudioPlaying) {
                    audioPlayer.pause();
                    audioPlayIcon.classList.remove('fa-pause');
                    audioPlayIcon.classList.add('fa-play');
                    isAudioPlaying = false;

                } else {
                    audioPlayer.play();
                    audioPlayIcon.classList.remove('fa-play');
                    audioPlayIcon.classList.add('fa-pause');
                    isAudioPlaying = true;
                }
            }

            if (audioCover && audioPlayBtn) {
                audioCover.addEventListener('click', toggleAudioPlay);
                audioPlayBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    toggleAudioPlay();
                });

                audioPlayer.addEventListener('ended', function() {
                    audioPlayIcon.classList.remove('fa-pause');
                    audioPlayIcon.classList.add('fa-play');
                    isAudioPlaying = false;
                });
            }
        });
    </script>
