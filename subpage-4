    <!-- 原有脚本 + 新增横向滚动记忆功能 -->
    <script>
        // 导航栏滚动效果
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
                navbar.classList.add('py-2', 'shadow-lg');
                navbar.classList.remove('py-3', 'shadow-md');
            } else {
                navbar.classList.add('py-3', 'shadow-md');
                navbar.classList.remove('py-2', 'shadow-lg');
            }
        });

        // 移动端菜单
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        let menuOpen = false;

        menuBtn.addEventListener('click', () => {
            if (menuOpen) {
                mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
                mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
                menuBtn.innerHTML = '<i class="fa fa-bars text-xl"></i>';
            } else {
                mobileMenu.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
                mobileMenu.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
                menuBtn.innerHTML = '<i class="fa fa-times text-xl"></i>';
            }
            menuOpen = !menuOpen;
        });

        // 平滑滚动
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                
                if (menuOpen) {
                    mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
                    mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
                    menuBtn.innerHTML = '<i class="fa fa-bars text-xl"></i>';
                    menuOpen = false;
                }
                
                const targetId = this.getAttribute('href');
                if (targetId === '#') return;
                
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });

        // 返回顶部按钮
        const backToTopBtn = document.getElementById('backToTop');
        
        window.addEventListener('scroll', () => {
            if (window.scrollY > 500) {
                backToTopBtn.classList.remove('opacity-0', 'invisible');
                backToTopBtn.classList.add('opacity-100', 'visible');
            } else {
                backToTopBtn.classList.add('opacity-0', 'invisible');
                backToTopBtn.classList.remove('opacity-100', 'visible');
            }
        });
        
        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        // 留言表单提交阻止默认行为（便于测试）
        document.querySelector('form').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('留言提交成功！我们会尽快给您回复~');
            this.reset();
        });

        // ========== 新增：横向滚动条记忆功能 ==========
        // 1. 保存滚动状态
        window.saveScrollState = function() {
            const scrollContent = document.getElementById('horizontalScrollContent');
            if (!scrollContent) return;

            // 获取当前滚动位置（百分比）
            const computedStyle = window.getComputedStyle(scrollContent);
            const transform = computedStyle.getPropertyValue('transform');
            let translateX = 0;
            
            if (transform && transform !== 'none') {
                const matrix = new DOMMatrix(transform);
                translateX = matrix.e; // 获取X轴偏移量
            }

            // 获取内容总宽度（单份内容）
            const contentWidth = scrollContent.scrollWidth / 2;
            // 计算滚动百分比
            const scrollPercent = Math.abs(translateX) / contentWidth;

            // 保存到localStorage
            localStorage.setItem('horizontalScrollState', JSON.stringify({
                scrollPercent: scrollPercent,
                timestamp: Date.now()
            }));
        };

        // 2. 恢复滚动状态并启动动画
        let scrollAnimationId = null;
        function initHorizontalScroll() {
            const scrollContent = document.getElementById('horizontalScrollContent');
            if (!scrollContent) return;

            // 清除之前的动画
            if (scrollAnimationId) {
                cancelAnimationFrame(scrollAnimationId);
            }

            // 配置 - 调整为稍稍慢一点的速度（从15改为20）
            const scrollSpeed = 30; // 20秒滚动完一轮（数值越小速度越快）
            const contentWidth = scrollContent.scrollWidth / 2; // 单份内容宽度
            let startPercent = 0;
            let startTime = Date.now();

            // 从localStorage恢复状态
            const savedState = localStorage.getItem('horizontalScrollState');
            if (savedState) {
                try {
                    const { scrollPercent, timestamp } = JSON.parse(savedState);
                    startPercent = scrollPercent;
                    // 计算已经过去的时间，调整起始时间
                    const elapsedTime = Date.now() - timestamp;
                    startTime = Date.now() - (elapsedTime % (scrollSpeed * 1000));
                } catch (e) {
                    console.error('恢复滚动状态失败:', e);
                }
            }

            // 动画函数
            function animateScroll() {
                // 计算已过去的时间（秒）
                const elapsed = (Date.now() - startTime) / 1000;
                // 计算当前滚动百分比（加上初始偏移）
                let currentPercent = (elapsed / scrollSpeed) + startPercent;
                // 循环滚动
                currentPercent = currentPercent % 1;
                
                // 计算X轴偏移量
                const translateX = -currentPercent * contentWidth;
                // 应用变换
                scrollContent.style.transform = `translateX(${translateX}px)`;
                
                // 继续动画
                scrollAnimationId = requestAnimationFrame(animateScroll);
            }

            // 启动动画
            animateScroll();
        }

        // 3. 页面离开时保存状态
        window.addEventListener('beforeunload', saveScrollState);

        // 4. 页面加载完成后初始化滚动
        document.addEventListener('DOMContentLoaded', initHorizontalScroll);

        // 5. 为所有外部链接添加保存状态的事件
        document.querySelectorAll('a:not([href^="#"])').forEach(link => {
            if (!link.hasAttribute('onclick')) {
                link.addEventListener('click', saveScrollState);
            }
        });
    </script>
